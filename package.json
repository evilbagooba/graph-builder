{
  "name": "tako-nerve",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tako": "github:evilbagooba/tako#v0.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "tsx": "^4.20.6",
    "typescript": "5.6.3",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "description": "The graph tool of the tako suite: an idea graph you can rearrange, with work, paths and op-diff review."
}
