{
  "name": "graph-builder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-size.mjs",
    "start": "tsx server/src/main.ts",
    "typecheck": "tsc --noEmit -p core/tsconfig.json && tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "test": "node --import tsx --test core/core.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
